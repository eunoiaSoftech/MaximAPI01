        Api_CommonResponse Response = new Api_CommonResponse();
        public ActionResult AddNewUser(string userCode = "")
        {
            var departmentList = Common.GetMasterDataForDropdown("DepartmentList");
            var roleList = Common.GetMasterDataForDropdown("GetRolesList");

            if (userCode == "")
            {
                ViewBag.departments = departmentList;
                ViewBag.roles = roleList;
                ViewBag.userCod = userCode;
                return View();
            }
            else
            {
                var UserMasterDetails = Common.GetuserDetails(userCode);
                ViewBag.departments = departmentList;
                ViewBag.roles = roleList;
                ViewBag.userCod = userCode;
                return View(UserMasterDetails);
            }


        }
        public ActionResult UserRights(int iPK_USRID = 0)
        {
            ViewBag.USerRights = GetUserRights(iPK_USRID);
            ViewBag.ApprovalLevel = GetApprovalLevel(iPK_USRID);
            ViewBag.mappingid = iPK_USRID;
            return View();
        }

        public List<DataControllerModel> GetUserRights(int iPK_USRID)
        {
            List<DataControllerModel> obj = new List<DataControllerModel>();


            SqlParameter[] param = new SqlParameter[2];
            param[0] = new SqlParameter("@Fk_BranchId", Convert.ToInt32(Session["iFk_BranchId"].ToString()));
            param[1] = new SqlParameter("@iPK_USRID", iPK_USRID);
            List<DataControllerModel> DataControl = new List<DataControllerModel>();
            DataSet ds = DBOperation.FillDataSet("[dbo].[USP_Admin_CustomRights_User]", param);
            if (ds != null && ds.Tables != null && ds.Tables[0].Rows.Count > 0)
            {
                Response.message = "Trip List";
                Response.statusCode = 200;
                Response.data = JsonConvert.SerializeObject(ds.Tables[0]);
                Response.responseCode = 1;
                if (Response.data != null)
                    DataControl = JsonConvert.DeserializeObject<List<DataControllerModel>>(Response.data.ToString());

            }


            else
            {
                Response.message = "No Data Available";
                Response.statusCode = 1;
                Response.responseCode = 1;
            }
            return DataControl;


        }
