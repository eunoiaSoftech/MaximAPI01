        public ActionResult Approvals(int ApprovalID = 0)
        {
            if (ApprovalID == 0)
            {
                var Menus = CommonController.GetMenusList();
                ViewBag.Menus = Menus;
                ViewBag.ApprovalID = ApprovalID;
                return View();
            }
            else
            {
                var Menus = CommonController.GetMenusList();
                ViewBag.Menus = Menus;
                ViewBag.ApprovalID = ApprovalID;
                ViewBag.ApprovalData = getApprovalDataForEdit(ApprovalID);
                ViewBag.ApprovalDataSetup = getApprovalAccountDataForEdit(ApprovalID);

                return View();
            }

        }

        public ActionResult Index()
        {
            ViewBag.ApprovalIdx = GetApprovalData();
            return View();
        }

        [HttpPost]
        public ActionResult AddNewuser(UserMaster userMst)
        {
            try
            {
                var json = JsonConvert.SerializeObject(userMst);
                var client = new RestClient(ConfigurationManager.AppSettings["BaseUrl"] + "User/AddNewUser");
                var request = new RestRequest(Method.POST);
                request.AddHeader("cache-control", "no-cache");
                //request.AddHeader("authorization", "bearer " + CurrentSessions.Token + "");
                request.AddParameter("application/json", json, ParameterType.RequestBody);
                request.AddHeader("Content-Type", "application/json");
                request.AddHeader("Accept", "application/json");
                IRestResponse response = client.Execute(request);

                if (response.StatusCode.ToString() == "OK")
                {
                    var objResponse = JsonConvert.DeserializeObject<Api_CommonResponse>(response.Content);

                    if (objResponse.message.Contains("Details Already Exists..!"))
                    {
                        TempData["IsUserDetailsExists"] = 1;
                        TempData["msg"] = "User Details Already Exists, Details Not Saved...";
                        return RedirectToAction("AddNewUserIndex", "User");
                    }
                    else
                    {
                        TempData["IsUserDetailsExists"] = 0;
                        TempData["msg"] = "User Details Saved Successfully!";
                        return RedirectToAction("AddNewUserIndex", "User");
                    }
                }
                else
                {
                    TempData["IsUserDetailsExists"] = 1;
                    TempData["msg"] = "Details Not Saved Due To Some Internal Issues...!";
                    return RedirectToAction("AddNewUserIndex", "User");
                }
            }
            catch (Exception ex)
            {
                throw ex;
            }
        }
        public ActionResult AddNewUserIndex()
        {
            var userList = Common.GetUsersListToActiveInactive("CompanyUser", 0);

            ViewBag.users = userList;

            return View();
        }




        public ActionResult EditProfile()
        {
            CommonController common = new CommonController();
            var userSession = (UserModelSession)Session["UserDetails"];

            var currentUser = CommonController.GetuserDetails(userSession.sUSRCode);
            // var roleList = common.GetDataForDropdown("Role", 0);

            // ViewBag.roles = roleList;
            ViewBag.currentUser = currentUser;

            return View();
        }
        public ActionResult UpdateUserDetails(UserMasterDetails _userMaster)
        {
            var json = JsonConvert.SerializeObject(_userMaster);
            var client = new RestClient(ConfigurationManager.AppSettings["BaseUrl"] + "User/UpdateuserDetails");
            var request = new RestRequest(Method.POST);
            request.AddHeader("cache-control", "no-cache");
            //request.AddHeader("authorization", "bearer " + CurrentSessions.Token + "");
            request.AddParameter("application/json", json, ParameterType.RequestBody);
            request.AddHeader("Content-Type", "application/json");
            request.AddHeader("Accept", "application/json");
            IRestResponse response = client.Execute(request);
            Api_CommonResponse objResponse = new Api_CommonResponse();
            if (response.StatusCode.ToString() == "OK")
            {
                objResponse = JsonConvert.DeserializeObject<Api_CommonResponse>(response.Content);
            }


            return RedirectToAction("AddNewUserIndex", "User");

        }

        public JsonResult ApprovalSave(approvalData data)
        {
            try
            {
                var aprvlID = 0;
                SqlParameter[] param = new SqlParameter[10];
                param[0] = new SqlParameter("@sEntryNo", data.sEntryNo);
                param[1] = new SqlParameter("@iFk_MenuId", data.iFk_MenuId);
                param[2] = new SqlParameter("@iFk_SubMnuId", data.iFk_SubMnuId);
                param[3] = new SqlParameter("@iTrnctnVisbl", data.iTrnctnVisbl);
                param[4] = new SqlParameter("@bApprvlAppcbl", data.bApprvlAppcbl);
                param[5] = new SqlParameter("@bValApprvl", data.bValApprvl);
                param[6] = new SqlParameter("@iModification", data.iModification);
                param[7] = new SqlParameter("@iFk_YearId", data.iFk_YearId);
                param[8] = new SqlParameter("@iFk_BrnchId", data.iFk_BrnchId);
                param[9] = new SqlParameter("@iCrtdBy", data.iCrtdBy);

                DataSet ds = DBOperation.FillDataSet("[dbo].[USP_Master_APRVCONFMST_Save]", param);
                if (ds != null && ds.Tables != null && ds.Tables[0].Rows.Count > 0)
                {
                    aprvlID = Convert.ToInt32(ds.Tables[0].Rows[0]["iPk_ApprvlId"]);

                    if (data.ApprovalList != null && data.ApprovalList.Count > 0)
                    {
                        foreach (var item in data.ApprovalList)
                        {
                            AccountDetailSave(item, aprvlID);
                        }
                    }
                    Response.responseCode = 0;
                    Response.message = ds.Tables[0].Rows[0]["Message"].ToString();
                    Response.statusCode = Convert.ToInt32(ds.Tables[0].Rows[0]["StatusCode"]);
                }
                else
                {
                    Response.responseCode = 1;
                    Response.message = $"We are facing server issue at the moment please try again...";
                    Response.statusCode = -1;
                    Response.data = null;
                }
            }
            catch (Exception ex)
            {
                throw ex;
            }
            return new JsonResult
            {
                Data = new { StatusCode = Response.statusCode, Data = Response, Failure = false, Message = Response.message },
                ContentEncoding = System.Text.Encoding.UTF8,
                JsonRequestBehavior = JsonRequestBehavior.AllowGet
            };
        }

        public string AccountDetailSave(approvalList data, int aprvlID)
        {
            var status = "";
            try
            {
                SqlParameter[] param = new SqlParameter[4];
                param[0] = new SqlParameter("@iFk_ApprvlId", aprvlID);
                param[1] = new SqlParameter("@sLevel", data.sLevel);
                param[2] = new SqlParameter("@dFromAmnt", data.dFromAmnt);
                param[3] = new SqlParameter("@dToAmnt", data.dToAmnt);

                DataSet ds = DBOperation.FillDataSet("USP_Master_APRVCONFDTL_Save", param);
                if (ds != null && ds.Tables != null && ds.Tables[0].Rows.Count > 0)
                {
                    status = ds.Tables[0].Rows[0]["Message"].ToString();
                    Response.statusCode = Convert.ToInt32(ds.Tables[0].Rows[0]["StatusCode"]);
                }
                else
                {
                    status = "We Are facing some internal issue, Please try again later";
                }
            }
            catch (Exception e)
            {
                throw e;
            }
            return status;
        }

        //Approval Index
        public List<approvalListData> GetApprovalData()
        {
            var client = new RestClient(ConfigurationManager.AppSettings["BaseUrl"] + "User/GetApprovalData");
            var request = new RestRequest(Method.GET);
            request.AddHeader("cache-control", "no-cache");
            //request.AddHeader("authorization", "bearer " + CurrentSessions.Token + "");
            request.AddParameter("application/json", "", ParameterType.RequestBody);
            request.AddHeader("Content-Type", "application/json");
            request.AddHeader("Accept", "application/json");
            IRestResponse response = client.Execute(request);
            Api_CommonResponse objResponse = new Api_CommonResponse();
            List<approvalListData> master = new List<approvalListData>();

            if (response.StatusCode.ToString() == "OK")
            {
                objResponse = JsonConvert.DeserializeObject<Api_CommonResponse>(response.Content);
                if (objResponse.data != null)
                {
                    //var serializedObj = JsonConvert.SerializeObject(objResponse.data);
                    master = JsonConvert.DeserializeObject<List<approvalListData>>(objResponse.data.ToString());
                }
            }

            return master;

        }

