        //Approval Account Details Save via edit 
        public JsonResult AmmountDetailsSave(approvalData data)
        {
            try
            {
                if (data.ApprovalList != null && data.ApprovalList.Count > 0)
                {
                    foreach (var item in data.ApprovalList)
                    {
                        AccountDetailsSave(item);
                    }
                }
            }
            catch (Exception ex)
            {
                throw ex;
            }
            return new JsonResult
            {
                Data = new { StatusCode = Response.statusCode, Data = Response, Failure = false, Message = Response.message },
                ContentEncoding = System.Text.Encoding.UTF8,
                JsonRequestBehavior = JsonRequestBehavior.AllowGet
            };
        }

