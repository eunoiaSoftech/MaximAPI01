                    Response.responseCode = 0;
                    Response.message = "Data Fetched Successfully...";
                    Response.data = JsonConvert.SerializeObject(ds.Tables[0]);
                }
                else
                {
                    Response.statusCode = 1;
                    Response.responseCode = 0;
                    Response.message = "No Data Available...";
                }
            }
            catch (Exception e)
            {
                Response.statusCode = 0;
                Response.responseCode = 0;
                Response.message = e.Message;
            }
            return Response;
        }


        //**************************************addnewuser

        [HttpPost]
        public JsonResult UpdateAddUserDetails(UserMaster userMst)
        {
            try
            {
                var json = JsonConvert.SerializeObject(userMst);
                var client = new RestClient(ConfigurationManager.AppSettings["BaseUrl"] + "User/UpdateAddUserDetails");
                var request = new RestRequest(Method.POST);
                request.AddHeader("cache-control", "no-cache");
                request.AddParameter("application/json", json, ParameterType.RequestBody);
                request.AddHeader("Content-Type", "application/json");
                request.AddHeader("Accept", "application/json");
                IRestResponse response = client.Execute(request);

                if (response.StatusCode == HttpStatusCode.OK)
                {
                    var objResponse = JsonConvert.DeserializeObject<Api_CommonResponse>(response.Content);

                    if (objResponse.message.Contains("Details Already Exists..!"))
                    {
                        return Json(new { success = false, Message = "User Details Already Exists, Details Not Saved..." });
                    }
                    else
                    {
                        return Json(new { success = true, Message = "User Details Saved Successfully!" });
                    }
                }
                else
                {
                    return Json(new { success = false, Message = "Details Not Saved Due To Some Internal Issues...!" });
                }
            }
            catch (Exception ex)
            {
                return Json(new { success = false, Message = $"Error: {ex.Message}" });
            }
        }



        public JsonResult DeactivateParty(UserMaster data)
        {
            try
            {
                SqlParameter[] param = new SqlParameter[3];
                param[0] = new SqlParameter("@sUSRCode", data.sUSRCode);
                param[1] = new SqlParameter("@dtDactvdate", data.dtDactvdate);
                param[2] = new SqlParameter("@iDactv", data.iDactv);

                DataSet ds = DBOperation.FillDataSet("USP_MASTER_DeactiveUser_Update", param);
                if (ds != null && ds.Tables != null && ds.Tables[0].Rows.Count > 0)
                {
                    Response.responseCode = 0;
                    Response.message = ds.Tables[0].Rows[0]["Message"].ToString();
                    Response.statusCode = Convert.ToInt32(ds.Tables[0].Rows[0]["StatusCode"]);
                }
                else
                {
                    Response.responseCode = 1;
                    Response.message = $"We are facing server issue at the moment please try again...";
                    Response.statusCode = -1;
                    Response.data = null;
                }
            }
            catch (Exception ex)
            {
                throw ex;
            }
            return Json(new
            {
                StatusCode = Response.statusCode,
                Data = Response,
                Failure = Response.statusCode != 200,
                Message = Response.message
            }, JsonRequestBehavior.AllowGet);
        }
    }

}
